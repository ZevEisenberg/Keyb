# Excludes

--exclude .build/**/*
--exclude Scripts/**/*

# Disabled Rules

--disable blankLinesBetweenImports
--disable modifiersOnSameLine
--disable redundantSwiftTestingSuite
--disable redundantVariable
--disable repeatedGuard
--disable swiftTestingTestCaseNames
--disable trailingClosures

# Enabled Rules

--enable blankLinesBetweenScopes
--enable commonTypos
--enable emptyExtensions
--enable environmentEntry
--enable noForceTryInTests
--enable noGuardInTests
--enable redundantEquatable
--enable wrapEnumCases
--enable wrapSwitchCases

# Options

--binary-grouping 4,8
--decimal-grouping 3,5
--exponent-case lowercase
--header strip
--ifdef no-indent
--import-grouping testable-last
--indent 2
--pattern-let inline
--ranges no-space
--self init-only
--someAny false
--strip-unused-args unnamed-only
--trailing-commas collections-only
--wrap-arguments before-first
--wrap-collections before-first
--wrap-parameters before-first
